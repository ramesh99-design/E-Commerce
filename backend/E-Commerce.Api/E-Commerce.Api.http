@host = http://localhost:5156

### Get all products
GET http://localhost:5156/api/products
Accept: application/json

### Get product by ID
GET http://localhost:5156/api/products/5
Accept: application/json

### Create product
POST http://localhost:5156/api/products
Content-Type: application/json

{
  "name": "1984",
  "price": 39.99,
  "category": "books",
  "stock": 20,
  "imageLink": "http://localhost:5156/images/book2.jpg",
  "description": "A dystopian novel by George Orwell.",
  "author": "George Orwell"
}
### Update product
PUT http://localhost:5156/api/products/5
Content-Type: application/json


{
  "name": "Air Pods",
  "price": 29999.00,
  "category": "electronics",
  "stock": 15,
  "imageLink": "https://i.pinimg.com/736x/d7/0b/77/d70b775a5360d537002581bca9fc1555.jpg",
  "description": "Wireless earbuds for everyday listening.",
}

### Delete product
DELETE http://localhost:5156/api/products/15